SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5178/api/auth/callback
# Optional Netscape-format YouTube cookie export:
YOUTUBE_COOKIES_FILE=
# Or read a browser on the machine running the backend (file above takes precedence):
YOUTUBE_BROWSER=
# Optional profile name/path and Linux keyring, e.g. Default and GNOMEKEYRING:
YOUTUBE_BROWSER_PROFILE=
YOUTUBE_BROWSER_KEYRING=
